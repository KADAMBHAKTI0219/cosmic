{
  "info": {
    "name": "COSMIC API Collection",
    "description": "Complete API collection for Cosmic Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "description": "Authentication related endpoints",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\",\n    \"confirmPassword\": \"password123\",\n    \"mobileNumber\": \"9876543210\",\n    \"phoneNumber\": \"0123456789\",\n    \"secondaryNumber\": \"1234567890\",\n    \"addressLine1\": \"123 Main Street\",\n    \"addressLine2\": \"Apt 4B\",\n    \"suburb\": \"Downtown\",\n    \"state\": \"State\",\n    \"zipCode\": \"123456\",\n    \"country\": \"India\",\n    \"companyName\": \"Company Ltd\",\n    \"gstNumber\": \"GST123456789\",\n    \"pan\": \"ABCDE1234F\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new user with all required fields"
          },
          "response": []
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\",\n    \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-otp"]
            },
            "description": "Verify OTP sent to user's email"
          },
          "response": []
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/resend-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "resend-otp"]
            },
            "description": "Resend OTP to user's email"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"authToken\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login with email and password"
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Request password reset link"
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"password\": \"newpassword123\",\n    \"confirmPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password/:token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password", ":token"],
              "variable": [
                {
                  "key": "token",
                  "value": "reset_token_here"
                }
              ]
            },
            "description": "Reset password with token"
          },
          "response": []
        },
        {
          "name": "Create Admin (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"Admin\",\n    \"lastName\": \"User\",\n    \"email\": \"admin@example.com\",\n    \"password\": \"adminpass123\",\n    \"confirmPassword\": \"adminpass123\",\n    \"mobileNumber\": \"9876543210\",\n    \"phoneNumber\": \"0123456789\",\n    \"secondaryNumber\": \"1234567890\",\n    \"addressLine1\": \"123 Admin Street\",\n    \"addressLine2\": \"Suite 100\",\n    \"suburb\": \"Admin City\",\n    \"state\": \"Admin State\",\n    \"zipCode\": \"654321\",\n    \"country\": \"India\",\n    \"companyName\": \"Admin Company\",\n    \"gstNumber\": \"GSTADMIN123\",\n    \"pan\": \"ADMIN1234G\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin"]
            },
            "description": "Create admin user (public route)"
          },
          "response": []
        },
        {
          "name": "Create Admin (Protected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"Admin\",\n    \"lastName\": \"User\",\n    \"email\": \"admin2@example.com\",\n    \"password\": \"adminpass123\",\n    \"confirmPassword\": \"adminpass123\",\n    \"mobileNumber\": \"9876543210\",\n    \"phoneNumber\": \"0123456789\",\n    \"secondaryNumber\": \"1234567890\",\n    \"addressLine1\": \"123 Admin Street\",\n    \"addressLine2\": \"Suite 100\",\n    \"suburb\": \"Admin City\",\n    \"state\": \"Admin State\",\n    \"zipCode\": \"654321\",\n    \"country\": \"India\",\n    \"companyName\": \"Admin Company\",\n    \"gstNumber\": \"GSTADMIN123\",\n    \"pan\": \"ADMIN1234G\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/create-admin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "create-admin"]
            },
            "description": "Create admin user (requires admin role)"
          },
          "response": []
        },
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "customers"]
            },
            "description": "Get all customers (admin only)"
          },
          "response": []
        },
        {
          "name": "Get Customer By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "customers", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "customer_id_here"
                }
              ]
            },
            "description": "Get customer by ID (own profile or admin)"
          },
          "response": []
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"Updated\",\n    \"lastName\": \"User\",\n    \"mobileNumber\": \"9876543210\",\n    \"phoneNumber\": \"0123456789\",\n    \"secondaryNumber\": \"1234567890\",\n    \"addressLine1\": \"123 Updated Street\",\n    \"addressLine2\": \"Apt 4B\",\n    \"suburb\": \"Downtown\",\n    \"state\": \"State\",\n    \"zipCode\": \"123456\",\n    \"country\": \"India\",\n    \"companyName\": \"Updated Company Ltd\",\n    \"gstNumber\": \"GST123456789\",\n    \"pan\": \"ABCDE1234F\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "customers", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "customer_id_here"
                }
              ]
            },
            "description": "Update customer profile"
          },
          "response": []
        },
        {
          "name": "Delete Customer",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "customers", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "customer_id_here"
                }
              ]
            },
            "description": "Delete customer profile"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ]
}