      "description": "Endpoints for managing product offers",
      "item": [
        {
          "name": "Create Offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"productId\": \"{{productId}}\",\n    \"title\": \"Summer Sale\",\n    \"description\": \"Get 20% off on all summer products\",\n    \"discountType\": \"percentage\",\n    \"discountValue\": 20,\n    \"startDate\": \"2023-06-01T00:00:00.000Z\",\n    \"endDate\": \"2023-08-31T23:59:59.999Z\",\n    \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/offers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "offers"]
            },
            "description": "Create a new offer for a product (Admin only)"
          }
        },
        {
          "name": "Get All Offers",
          "request": {
            "method": "GET",
            "header": [],
